# Unity generated folders
[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Bb]uild/
[Bb]uilds/
androidBuilds/
[Ll]ogs/
[Uu]ser[Ss]ettings/
[Mm]emoryCaptures/
Recordings/
output/
.utmp/

# Unity filesystem-timestamp probe files (Temp/FSTimeGet-*, Temp/UnityLockfile).
# Unity logs "currentFileSystemTime.ticks != 0" on btrfs about these; never commit.
/Temp/
Temp/FSTimeGet-*

# Asset meta data (keep meta files, but ignore these)
/[Aa]ssets/AssetStoreTools*
/[Aa]ssets/Plugins/Editor/JetBrains*

# Autogenerated VS/Rider/IDE files
.vs/
.vsconfig
.idea/
*.csproj
*.unityproj
*.sln
*.slnx
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Unity3D generated meta files
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Unity3D generated file on crash reports
sysinfo.txt

# Builds
*.apk
*.aab
*.unitypackage
*.app

# Crashlytics
crashlytics-build.properties

# Mono/Unity crash dumps
*.blob
mono_crash.*

# Keystores (do not commit signing keys)
*.keystore
*.jks
GooglePlay/

# Android signing (never commit)
android-keystore.properties
*.jks
*.keystore

# Node / Toss miniapp
node_modules/

# Generated store packages and Toss web output
*.ait
/toss/dist/
/toss/public/
/toss/index.html
/toss/.granite/
